# Copy to .env.local for local development. Never commit real credentials.
# Direct Neon endpoint for Prisma CLI migrations.
DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=verify-full&channel_binding=require"
# Pooled Neon endpoint for the running Next.js app (host contains -pooler).
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLED_HOST/DB?sslmode=verify-full&channel_binding=require"
AUTH_SECRET="replace-with-a-new-32-byte-base64-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console -> OAuth 2.0 Web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification (Resend; verify your sending domain first)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS verification (Termii; use the base URL shown in your Termii dashboard)
TERMII_API_KEY=
# Replace with the exact API base URL shown in your Termii dashboard
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd

# Maps (Leaflet + tile provider URL template; default uses OSM standard tiles)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Public OSRM demo router is best-effort; self-host or replace before scale
QNOT_ROUTING_BASE_URL=https://router.project-osrm.org

# Payments (Paystack TEST key locally; use LIVE key only after compliance review)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Paystack Dashboard → Developers → API configuration → Webhook signing secret (whsec_...)
PAYSTACK_WEBHOOK_SECRET=

# Comma-separated emails of Q-not network reviewers
QNOT_NETWORK_ADMIN_EMAILS=

# Secret for scheduled payment reconciliation POST /api/payments/reconcile
QNOT_CRON_SECRET=
